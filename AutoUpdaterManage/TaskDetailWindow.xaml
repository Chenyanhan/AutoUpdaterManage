<dx:ThemedWindow x:Class="AutoUpdaterManage.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="任务详情" Width="900" Height="650"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        ShowIcon="True" Icon="Assets/AppIcon.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="任务详情" FontSize="23" FontWeight="SemiBold"
                           Foreground="#172033"/>
                <TextBlock x:Name="RequestIdText" Margin="0,5,0,0"
                           Foreground="#667085"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E8F0FE" CornerRadius="15"
                    Padding="14,6" VerticalAlignment="Center">
                <TextBlock x:Name="StateText" Foreground="#315A97"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="9"
                Padding="18" Margin="0,18,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="设备" Foreground="#667085"/>
                    <TextBlock x:Name="DeviceText" Margin="0,5,0,0"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="IpText" Margin="0,3,0,0"
                               Foreground="#667085"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="操作与版本" Foreground="#667085"/>
                    <TextBlock x:Name="OperationText" Margin="0,5,0,0"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Margin="0,3,0,0"
                               Foreground="#667085"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="发送信息" Foreground="#667085"/>
                    <TextBlock x:Name="AttemptText" Margin="0,5,0,0"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="UpdatedAtText" Margin="0,3,0,0"
                               Foreground="#667085"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="9">
            <DataGrid x:Name="EventsGrid" IsReadOnly="True"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EDF1F6"
                      RowHeight="42" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}"
                                        Width="145"/>
                    <DataGridTextColumn Header="阶段" Binding="{Binding Stage}"
                                        Width="110"/>
                    <DataGridTextColumn Header="进度" Binding="{Binding PercentageText}"
                                        Width="65"/>
                    <DataGridTextColumn Header="事件信息" Binding="{Binding DetailText}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="SourceText" VerticalAlignment="Center"
                       MaxWidth="580" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Foreground="#667085"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="复制详情" Padding="15,8"
                        Margin="0,0,10,0" Click="Copy_Click"/>
                <Button Content="导出文本" Padding="15,8"
                        Click="Export_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</dx:ThemedWindow>
