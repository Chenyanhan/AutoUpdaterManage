<dx:ThemedWindow x:Class="AutoUpdaterManage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="设备运维控制台" Height="800" Width="1320" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA"
        ShowIcon="True" Icon="Assets/AppIcon.ico">
    <dx:ThemedWindow.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#172033"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#667085"/>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E9EEF6"/>
            <Setter Property="Foreground" Value="#27364F"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="BorderBrush" Value="#D5DCE8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#D5DCE8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#14213A">
            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Primary}" Margin="0,0,12,0">
                        <TextBlock Text="AU" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="设备运维控制台" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="局域网设备管理与维护" Foreground="#8FA0BC" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="#3BD18A" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ConnectionText" Text="UDP 控制服务运行中" Foreground="#CAD3E1"/>
                    <Border Background="#243552" CornerRadius="12" Padding="10,4" Margin="16,0,0,0">
                        <TextBlock Text="控制端 45677 · 设备端 45678" Foreground="#B8C4D7" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <dx:DXTabControl Grid.Row="1" Margin="22,14,22,20" Background="Transparent" BorderThickness="0">
            <dx:DXTabItem Header="软件更新">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="软件版本管理" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="检索局域网设备，批量下发更新或版本回退任务"
                                       Margin="0,5,0,0" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="更新包发布" Margin="0,0,10,0" Click="OpenPackageBuilder_Click"/>
                            <TextBlock Text="更新清单" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="UpdatePathBox" Width="310" Margin="0,0,10,0"
                                     ToolTip="例如：\\192.168.1.10\updates\manifest.json 或 https://server/updates/manifest.json"/>
                            <Button Content="检索设备" Margin="0,0,10,0" Click="Discover_Click"/>
                            <Button Content="版本回退" Margin="0,0,10,0" Click="Rollback_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="下发更新" Click="SendUpdate_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="White" CornerRadius="9" Padding="15" Margin="0,18,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocalIpBox" TextChanged="LocalIpBox_TextChanged"
                                     ToolTip="本机 IPv4/CIDR，例如 192.168.1.25/24"/>
                            <Border Grid.Column="1" Background="#F3F6FA" CornerRadius="5" Margin="10,0,0,0" Padding="10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="广播：" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="BroadcastAddressText" Text="—" FontWeight="SemiBold" Foreground="#315A97"/>
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="SearchBox" Grid.Column="2" Margin="10,0,0,0"
                                     TextChanged="Filter_Changed" ToolTip="输入设备名称、编号或 IP"/>
                            <ComboBox x:Name="StatusFilter" Grid.Column="3" Margin="10,0,0,0"
                                      SelectionChanged="Filter_Changed" SelectedIndex="0">
                                <ComboBoxItem Content="全部状态"/>
                                <ComboBoxItem Content="在线"/>
                                <ComboBoxItem Content="离线"/>
                                <ComboBoxItem Content="更新中"/>
                            </ComboBox>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SummaryText" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="9">
                        <dxg:GridControl x:Name="DeviceGrid" ItemsSource="{Binding Devices}">
                            <dxg:GridControl.View>
                                <dxg:TableView ShowGroupPanel="False" ShowSearchPanelMode="Never"
                                               AutoWidth="True" AllowPerPixelScrolling="True"
                                               ShowIndicator="False" RowMinHeight="44"
                                               NavigationStyle="Row"/>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="IsSelected" Width="55">
                                <dxg:GridColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="勾选全选，取消勾选清空"
                                                  Checked="HeaderSelectAll_Checked"
                                                  Unchecked="HeaderSelectAll_Unchecked"/>
                                    </DataTemplate>
                                </dxg:GridColumn.HeaderTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Name" Header="设备名称" Width="135"/>
                            <dxg:GridColumn FieldName="DeviceId" Header="设备编号" Width="150"/>
                            <dxg:GridColumn FieldName="IpAddress" Header="IP 地址" Width="105"/>
                            <dxg:GridColumn FieldName="CurrentVersion" Header="当前版本" Width="90"/>
                            <dxg:GridColumn FieldName="StatusText" Header="状态" Width="75" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="UpdateResult" Header="任务结果" Width="145" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="LastSeenText" Header="最后响应" Width="130" AllowEditing="False"/>
                        </dxg:GridControl>
                    </Border>

                    <Border Grid.Row="3" Background="#E8F0FE" CornerRadius="7" Padding="14,9" Margin="0,11,0,0">
                        <Grid>
                            <TextBlock x:Name="SelectionText" Text="尚未选择设备" Foreground="#315A97"/>
                            <TextBlock Text="离线设备不会接收任务 · 更新前请确保更新源可访问"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </dx:DXTabItem>

            <dx:DXTabItem Header="数据库同步">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="DatabaseWorkspace" Grid.ColumnSpan="2"
                          Panel.ZIndex="10" Background="#F3F6FA">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="White" CornerRadius="9" Padding="15"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DatabaseProviderBox" SelectedIndex="0">
                                    <ComboBoxItem Content="MySQL"/>
                                    <ComboBoxItem Content="SQLite"/>
                                </ComboBox>
                                <TextBox x:Name="DatabaseHostBox" Grid.Column="1"
                                         Text="127.0.0.1"
                                         Margin="10,0,0,0"
                                         ToolTip="MySQL服务器"/>
                                <TextBox x:Name="DatabasePortBox" Grid.Column="2"
                                         Text="3306"
                                         Margin="10,0,0,0"
                                         ToolTip="端口"/>
                                <TextBox x:Name="DatabaseUserBox" Grid.Column="3"
                                         Text="root"
                                         Margin="10,0,0,0"
                                         ToolTip="用户名"/>
                                <PasswordBox x:Name="DatabasePasswordBox" Grid.Column="4"
                                             Margin="10,0,0,0"
                                             ToolTip="密码"/>
                                <TextBox x:Name="DatabaseNameBox" Grid.Column="5"
                                         Text="leadchina_project"
                                         Margin="10,0,0,0"
                                         ToolTip="数据库名"/>
                                <Button Grid.Column="6" Content="连接"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="ConnectDatabase_Click"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="White" CornerRadius="9"
                                    Padding="14" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="数据表" FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DatabaseConnectionText"
                                                   Text="尚未连接数据库"
                                                   Margin="0,4,0,12" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <ListBox x:Name="DatabaseTablesList" Grid.Row="1"
                                             SelectionChanged="DatabaseTable_SelectionChanged"
                                             BorderThickness="0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="White" CornerRadius="9"
                                    Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="14,12">
                                        <TextBlock x:Name="CurrentTableText"
                                                   Text="请选择数据表"
                                                   FontSize="17" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="新增" Margin="0,0,8,0"
                                                    Click="AddDatabaseDraft_Click"/>
                                            <Button Content="编辑" Margin="0,0,8,0"
                                                    Click="EditDatabaseDraft_Click"/>
                                            <Button Content="删除"
                                                    Click="DeleteDatabaseDraft_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid x:Name="DatabaseDataGrid" Grid.Row="1"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              RowHeight="30"
                                              BorderThickness="0"/>
                                    <Grid Grid.Row="2" Margin="14,10">
                                        <Button Content="上一页" HorizontalAlignment="Left"
                                                Click="PreviousDatabasePage_Click"/>
                                        <TextBlock x:Name="DatabasePageText"
                                                   Text="第 0 / 0 页"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <Button Content="下一页" HorizontalAlignment="Right"
                                                Click="NextDatabasePage_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="White" CornerRadius="9"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="待同步变更" FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="本阶段只生成草稿，不会写入数据库"
                                                   Margin="0,4,0,12" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <ListBox x:Name="DatabaseDraftsList" Grid.Row="1"
                                             ItemsSource="{Binding DatabaseDrafts}"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           Margin="4,6"
                                                           ToolTip="{Binding Summary}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="移除"
                                                    HorizontalAlignment="Stretch"
                                                    Click="RemoveDatabaseDraft_Click"/>
                                            <Button x:Name="ApplyDatabaseDraftsButton"
                                                    Grid.Column="2"
                                                    Content="应用到本机"
                                                    HorizontalAlignment="Stretch"
                                                    Click="ApplyDatabaseDrafts_Click"/>
                                        </Grid>
                                        <Button x:Name="SyncDatabaseDraftsButton"
                                                Grid.Row="1"
                                                Content="同步到设备"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,10,0,0"
                                                Click="SyncDatabaseDrafts_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="#EEF4FF" CornerRadius="7"
                                Padding="12,8" Margin="0,11,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="310"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="同步包共享目录"
                                           VerticalAlignment="Center"
                                           Foreground="#315A97"/>
                                <TextBox x:Name="DatabaseSyncDirectoryBox"
                                         Grid.Column="1"
                                         Margin="10,0,14,0"
                                         Text="D:\UpdaterLab\DatabaseSyncOutput"
                                         ToolTip="必须填写所有目标设备都能访问的本地路径或UNC共享路径"/>
                                <TextBlock x:Name="DatabaseStatusText"
                                           Grid.Column="2"
                                           Text="请选择数据库开始浏览"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           Foreground="#315A97"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Background="White" CornerRadius="10" Padding="24" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="数据库同步任务" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="向选中设备同步数据库文件或执行迁移脚本" Margin="0,6,0,24"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="同步来源" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,7"/>
                            <TextBox IsEnabled="False" Text="后续支持：共享数据库文件 / SQL 脚本 / HTTP 下载地址"/>
                            <TextBlock Text="执行策略" Foreground="{StaticResource TextSecondary}" Margin="0,18,0,7"/>
                            <ComboBox IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="备份后覆盖"/>
                                <ComboBoxItem Content="执行迁移脚本"/>
                            </ComboBox>
                            <Button Content="功能待接入" IsEnabled="False" HorizontalAlignment="Left" Margin="0,22,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#EEF4FF" CornerRadius="10" Padding="22">
                        <StackPanel>
                            <TextBlock Text="安全要求" FontSize="17" FontWeight="SemiBold" Foreground="#294E87"/>
                            <TextBlock Text="• 同步前自动备份数据库&#x0a;• 校验文件 SHA-256&#x0a;• 数据库占用时禁止覆盖&#x0a;• 支持失败自动恢复&#x0a;• 返回每台设备执行结果"
                                       Margin="0,16,0,0" LineHeight="28" Foreground="#526A8D"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </dx:DXTabItem>

            <dx:DXTabItem Header="配置同步">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="24" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="配置文件同步" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="分发 JSON、XML、INI 等配置，并保留设备本地差异项" Margin="0,6,0,24"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="配置来源" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,7"/>
                            <TextBox IsEnabled="False" Text="后续支持：配置文件路径或配置模板"/>
                            <TextBlock Text="合并方式" Foreground="{StaticResource TextSecondary}" Margin="0,18,0,7"/>
                            <ComboBox IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="完整覆盖"/>
                                <ComboBoxItem Content="按配置项合并"/>
                                <ComboBoxItem Content="仅更新指定字段"/>
                            </ComboBox>
                            <Button Content="功能待接入" IsEnabled="False" HorizontalAlignment="Left" Margin="0,22,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#F1F8F4" CornerRadius="10" Padding="22">
                        <StackPanel>
                            <TextBlock Text="建议能力" FontSize="17" FontWeight="SemiBold" Foreground="#276749"/>
                            <TextBlock Text="• 同步前保存旧配置&#x0a;• 支持设备变量占位符&#x0a;• 同步后验证配置格式&#x0a;• 必要时重启上位机&#x0a;• 支持一键恢复旧配置"
                                       Margin="0,16,0,0" LineHeight="28" Foreground="#527062"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </dx:DXTabItem>

            <dx:DXTabItem Header="数据库同步历史">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="数据库同步历史" FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="记录每台目标设备的数据库、变更数量、发送次数与最终结果"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新记录"
                                VerticalAlignment="Center"
                                Click="RefreshTasks_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Background="White" CornerRadius="9"
                            Margin="0,18,0,0">
                        <dxg:GridControl ItemsSource="{Binding DatabaseSyncTasks}">
                            <dxg:GridControl.View>
                                <dxg:TableView ShowGroupPanel="False"
                                               ShowSearchPanelMode="Always"
                                               SearchPanelFindMode="Always"
                                               AutoWidth="True"
                                               AllowPerPixelScrolling="True"
                                               ShowIndicator="False"
                                               RowMinHeight="44"
                                               NavigationStyle="Row"/>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="ShortId" Header="任务号"
                                            Width="80" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="DeviceName" Header="设备名称"
                                            Width="125" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="DeviceId" Header="设备编号"
                                            Width="145" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="IpAddress" Header="IP地址"
                                            Width="105" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="Source" Header="数据库"
                                            Width="125" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="TargetVersion" Header="变更数量"
                                            Width="85" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="StateText" Header="状态"
                                            Width="85" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="AttemptText" Header="发送次数"
                                            Width="80" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="Message" Header="执行结果"
                                            Width="210" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="UpdatedAtText" Header="完成时间"
                                            Width="140" AllowEditing="False"/>
                        </dxg:GridControl>
                    </Border>

                    <Border Grid.Row="2" Background="#F7F9FC" CornerRadius="7"
                            Padding="12,8" Margin="0,11,0,0">
                        <TextBlock Text="记录保存在本地 tasks.db，可通过任务号关联设备端日志"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"/>
                    </Border>
                </Grid>
            </dx:DXTabItem>

            <dx:DXTabItem Header="任务记录">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="任务执行记录" FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="记录每台设备的软件更新、版本回退及执行结果"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新记录"
                                VerticalAlignment="Center"
                                Click="RefreshTasks_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Background="White" CornerRadius="9"
                            Padding="15" Margin="0,18,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TaskSearchBox"
                                     TextChanged="TaskFilter_Changed"
                                     ToolTip="搜索任务号、设备、IP或结果信息"/>
                            <ComboBox x:Name="TaskStatusFilter" Grid.Column="1"
                                      Margin="10,0,0,0" SelectedIndex="0"
                                      SelectionChanged="TaskFilter_Changed">
                                <ComboBoxItem Content="全部状态"/>
                                <ComboBoxItem Content="正在下发"/>
                                <ComboBoxItem Content="已下发"/>
                                <ComboBoxItem Content="设备已接受"/>
                                <ComboBoxItem Content="稍后更新"/>
                                <ComboBoxItem Content="成功"/>
                                <ComboBoxItem Content="失败"/>
                                <ComboBoxItem Content="设备无响应"/>
                            </ComboBox>
                            <TextBlock x:Name="TaskSummaryText" Grid.Column="2"
                                       Margin="18,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="9">
                        <dxg:GridControl x:Name="TaskGrid" ItemsSource="{Binding Tasks}"
                                         MouseDoubleClick="TaskGrid_MouseDoubleClick">
                            <dxg:GridControl.View>
                                <dxg:TableView ShowGroupPanel="False"
                                               ShowSearchPanelMode="Never"
                                               AutoWidth="True"
                                               AllowPerPixelScrolling="True"
                                               ShowIndicator="False"
                                               RowMinHeight="44"
                                               NavigationStyle="Row"/>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="ShortId" Header="任务号"
                                            Width="75" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="OperationText" Header="操作"
                                            Width="80" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="DeviceName" Header="设备名称"
                                            Width="115" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="DeviceId" Header="设备编号"
                                            Width="135" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="IpAddress" Header="IP地址"
                                            Width="100" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="SourceVersion" Header="原版本"
                                            Width="75" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="ResultVersion" Header="结果版本"
                                            Width="75" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="StateText" Header="状态"
                                            Width="85" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="AttemptText" Header="发送次数"
                                            Width="70" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="Message" Header="执行信息"
                                            Width="160" AllowEditing="False"/>
                            <dxg:GridColumn FieldName="UpdatedAtText" Header="更新时间"
                                            Width="135" AllowEditing="False"/>
                        </dxg:GridControl>
                    </Border>

                    <Border Grid.Row="3" Background="#F7F9FC" CornerRadius="7"
                            Padding="12,8" Margin="0,11,0,0">
                        <TextBlock x:Name="TaskStorageStatusText"
                                   Text="正在加载本地任务记录"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"/>
                    </Border>
                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</dx:ThemedWindow>
